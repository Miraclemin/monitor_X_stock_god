# twitterapi.io —— 注册后获取 API key
TWITTERAPI_KEY=YOUR_TWITTERAPI_KEY
# 要监控的 X 账号用户名（不带 @）
WATCH_USERNAME=aleabitoreddit
# twitterapi.io filter rule 标签
WATCH_TAG=serenity_stock_god
# 规则后台检查间隔（秒）。tweet_filter 会按该间隔轮询；空结果也可能产生最低请求费
WATCH_INTERVAL_SECONDS=60
# 留空首次运行会自动创建并回填
RULE_ID=
# 独立数据库路径（相对模块目录）
DB_PATH=data/monitor.sqlite
# Ctrl+C 退出时是否停用规则以停止计费
DEACTIVATE_ON_EXIT=true

# 历史 / 离线补漏：免费 X GraphQL curl
HISTORY_ENABLED=true
HISTORY_RUN_ON_START=true
HISTORY_MODE_ON_START=incremental
# 存放浏览器复制的 *.curl 的目录
HISTORY_X_CURL_DIR=x_curl
HISTORY_MAX_PAGES=200
HISTORY_PAUSE_SECONDS=0.8

# 任意 OpenAI 兼容 chat completions 接口
LLM_URL=https://api.example.com/v1/chat/completions
LLM_KEY=YOUR_LLM_KEY
LLM_MODEL=YOUR_LLM_MODEL
TRANSLATE_ENABLED=true

# 邮件（Gmail 需用「应用专用密码 App Password」，不是登录密码）
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=you@example.com
EMAIL_PASSWORD=YOUR_APP_PASSWORD
EMAIL_FROM=you@example.com
# 多个收件人用逗号分隔
EMAIL_TO=you@example.com

# 桌面 / Telegram / Webhook 通知开关
NOTIFY_DESKTOP=true
NOTIFY_SOUND=true
NOTIFY_TELEGRAM_ENABLED=false
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
